---
import { SITE } from '../../site.config.mjs';
import { url } from '../lib/paths.ts';

const { name, url: site } = SITE.maintainer;
---

<footer class="site-footer">
  <div class="wrap">
    <p class="site-footer-name">PLFM · Programming Languages &amp; Formal Methods</p>
    <p class="site-footer-meta">
      An open source repository maintained by {
        site ? <a href={site} rel="noopener">{name}</a> : <span>{name}</span>
      }
    </p>
    <p class="site-footer-links">
      <a href={url('/archive')}>Archive</a>
    </p>
  </div>
</footer>
