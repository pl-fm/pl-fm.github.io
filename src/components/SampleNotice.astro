---
import { hasOnlySampleData, sampleCount } from '../lib/data.ts';

const count = sampleCount();
const onlySamples = hasOnlySampleData();
---

{
  count > 0 && (
    <p class="notice">
      <strong>Sample data.</strong>{' '}
      {onlySamples
        ? 'Every entry below is a placeholder that demonstrates the interface. None of them are real announcements.'
        : `${count} of the entries below are placeholders that demonstrate the interface, marked "sample". They are not real announcements.`}
    </p>
  )
}
