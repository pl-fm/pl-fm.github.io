---
import type { CalendarRegions } from '../lib/views.ts';

export interface Props {
  calendar: CalendarRegions;
}

const { calendar } = Astro.props;
---

<section class="cal-section" data-calendar="all" aria-labelledby="cal-title">
  <div class="cal-bar">
    <button class="cal-nav" type="button" data-cal-prev aria-label="Previous month">
      <span aria-hidden="true">&lsaquo;</span>
    </button>
    <h2 class="cal-title" id="cal-title" aria-live="polite">{calendar.monthTitle}</h2>
    <button class="cal-nav" type="button" data-cal-next aria-label="Next month">
      <span aria-hidden="true">&rsaquo;</span>
    </button>
    <button class="cal-today" type="button" data-cal-today>Today</button>

    <div class="cal-search">
      <label class="sr-only" for="plfm-search">Search entries</label>
      <input
        id="plfm-search"
        type="search"
        data-search
        placeholder="Search acronym, name, or topic"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
  </div>

  <div class="cal-grid-view" id="cal-grid" set:html={calendar.grid} />
  <div class="cal-agenda" id="cal-agenda" set:html={calendar.agenda} />
  <div
    id="cal-legend"
    data-filter-group="category"
    role="group"
    aria-label="Categories: colour key, and a filter for the calendar"
    set:html={calendar.legend}
  />
</section>
