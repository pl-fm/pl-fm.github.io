---
import { SITE } from '../../site.config.mjs';

const { email } = SITE.maintainer;
---

<section class="contribute" aria-labelledby="contribute-title">
  <h2 id="contribute-title">Missing something?</h2>
  <p>
    Know of a conference, workshop, summer school, or submission deadline
    that should be on PLFM? Spot an error? Write to
    <a href={`mailto:${email}`}>{email}</a>.
  </p>
</section>
