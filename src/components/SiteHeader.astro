---
import { lastVerified } from '../lib/data.ts';
import { formatDate } from '../lib/dates.ts';
import { url } from '../lib/paths.ts';

const updated = lastVerified();
---

<header class="wrap">
  <div class="masthead">
    <h1 class="masthead-title"><a href={url('/')}>PLFM</a></h1>
    <p class="masthead-sub">
      Conferences, workshops, schools, events, and opportunities for the PL and
      formal methods community.
    </p>
    {
      updated && (
        <p class="masthead-updated">
          Last updated <time datetime={updated}>{formatDate(updated)}</time>
        </p>
      )
    }

    <button class="theme-toggle" type="button" data-theme-toggle>
      <span class="sr-only">Switch to </span>
      <svg
        class="theme-icon theme-icon-dark"
        viewBox="0 0 20 20"
        width="15"
        height="15"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M16.5 12.4A7 7 0 0 1 7.6 3.5a7 7 0 1 0 8.9 8.9Z"></path>
      </svg>
      <svg
        class="theme-icon theme-icon-light"
        viewBox="0 0 20 20"
        width="15"
        height="15"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="10" cy="10" r="3.6"></circle>
        <path d="M10 1.6v2M10 16.4v2M1.6 10h2M16.4 10h2M4.1 4.1l1.4 1.4M14.5 14.5l1.4 1.4M15.9 4.1l-1.4 1.4M5.5 14.5l-1.4 1.4"></path>
      </svg>
      <span class="sr-only theme-word-dark">dark theme</span>
      <span class="sr-only theme-word-light">light theme</span>
    </button>
  </div>
</header>
