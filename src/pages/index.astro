---
import Base from '../layouts/Base.astro';
import CalendarSection from '../components/CalendarSection.astro';
import { SITE } from '../../site.config.mjs';
import { loadEntries } from '../lib/data.ts';
import { todayKey } from '../lib/dates.ts';
import { EMPTY_FILTER } from '../lib/filter.ts';
import { calendarJsonLd, jsonLdPayload } from '../lib/jsonld.ts';
import { jsonPayload } from '../lib/render.ts';
import { SHOW_OPTIONS } from '../lib/taxonomy.ts';
import { homeView } from '../lib/views.ts';

const today = todayKey();
const [year, month] = today.split('-').map(Number);
const entries = loadEntries();

const now = Date.now();

const show = 'all';
const view = homeView({
  entries,
  state: { ...EMPTY_FILTER, show },
  now,
  today,
  year: year!,
  month: month!,
});
---

<Base>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={jsonLdPayload(calendarJsonLd(entries, now))}
  />

  <div data-page="home" data-year={year} data-month={month} data-built-day={today}>
    <div class="viewtabs" role="group" aria-label="Show" data-filter-group="show">
      {
        SHOW_OPTIONS.map((option) => (
          <button
            class="viewtab"
            type="button"
            data-value={option.value}
            aria-pressed={option.value === show ? 'true' : 'false'}
          >
            {option.label}
          </button>
        ))
      }
    </div>

    <CalendarSection calendar={view} />

    <section class="section" aria-labelledby="month-heading">
      <h2 class="section-title" id="month-heading">{view.monthHeading}</h2>
      <div id="month-list" set:html={view.monthList} />
    </section>

    <section class="section" aria-labelledby="upcoming-heading">
      <h2 class="section-title" id="upcoming-heading">{view.upcomingHeading}</h2>
      <p class="result-count" id="upcoming-count">{view.count}</p>
      <div id="upcoming-list" set:html={view.upcomingList} />
      <p class="section-note">{SITE.maintainerNote}</p>
    </section>

    <script
      type="application/json"
      id="plfm-entries"
      is:inline
      set:html={jsonPayload(entries)}
    />
  </div>

  <script>
    import { initHome } from '../scripts/home.ts';
    initHome();
  </script>
</Base>
