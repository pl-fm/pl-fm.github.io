---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Contribute from '../components/Contribute.astro';
import DetailDialog from '../components/DetailDialog.astro';
import { SITE } from '../../site.config.mjs';
import { url } from '../lib/paths.ts';
import { jsonLdPayload, websiteJsonLd } from '../lib/jsonld.ts';

export interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;

const pageTitle = title ? `${SITE.title} | ${title}` : `${SITE.title} | Calendar`;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(url('/og.png'), SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="google-site-verification" content="60ob-1VaCu4tNSVckvCLbNP6nY4T76sEytPJOuhd2eE" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PLFM" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" is:inline set:html={jsonLdPayload(websiteJsonLd())} />
    <slot name="head" />

    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101012" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      try {
        var stored = localStorage.getItem('plfm-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) {
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />

    <main id="main" class="wrap">
      <slot />
      <Contribute />
    </main>

    <SiteFooter />
    <DetailDialog />

    <script>
      import { initChrome } from '../scripts/chrome.ts';
      initChrome();
    </script>
  </body>
</html>
